load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "pictago_v1_proto",
    srcs = ["authentication.proto"],
    visibility = ["//visibility:public"],
    deps = ["//google/api:api_proto"],
)

go_proto_library(
    name = "pictago_v1_go_proto",
    importpath = "github.com/ai-slop-code/pictago/api/proto/pictago/v1",
    proto = ":pictago_v1_proto",
    visibility = ["//visibility:public"],
    deps = ["//google/api:annotations_proto"],
)

go_library(
    name = "pictago",
    embed = [":pictago_v1_go_proto"],
    importpath = "github.com/ai-slop-code/pictago/api/proto/pictago/v1",
    visibility = ["//visibility:public"],
)
