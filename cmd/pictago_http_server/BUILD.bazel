)

go_library(
    name = "pictago_http_server_lib",
    srcs = ["main.go"],
    importpath = "github.com/ai-slop-code/pictago/cmd/pictago_http_server",
    visibility = ["//visibility:private"],
    deps = [
        "//api/proto/pictago/v1:v1_grpc_gateway",
        "//assets",
        "//internal/config",
        "//internal/log",
        "//pkg/authentication",
        "//pkg/file",
        "//pkg/user_configuration",
        "//pkg/user_info",
        "//pkg/user_management",
        "@com_github_grpc_ecosystem_go_grpc_middleware_v2//interceptors/logging",
        "@org_golang_google_grpc//:grpc",
    ],
)
